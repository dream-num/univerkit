{
  "name": "@univerkit/html-view-parser",
  "version": "1.0.0-rc.1",
  "description": "Declarative HTML cell binding syntax and parsing for Univer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dream-num/univerkit.git",
    "directory": "packages/html-view-parser"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "docs",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://insider-npm-registry.univer.work/"
  },
  "scripts": {
    "build": "pnpm run release:build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:build": "node ../../scripts/package-build.mjs"
  },
  "dependencies": {
    "parse5": "8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
